# Reference only: the launcher manages its own configuration, and the backend
# does not automatically load this file. Do not put real secrets in this template.
# Shared launcher/backend data directory; unset means ~/.gori-agent.
SSH_AGENT_DATA_DIR=
SSH_AGENT_WEB_PORT=3000
# REST and SSE use separate browser connection budgets. Rebuild after changing either port.
SSH_AGENT_PORT=3001
SSH_AGENT_EVENTS_PORT=3002

# Optional overrides. Without a key override, reuse/create DATA_DIR/credential-key.
# An existing database with a missing key refuses startup.
SSH_AGENT_DATABASE_PATH=
SSH_AGENT_CREDENTIAL_KEY_BASE64=
SSH_AGENT_LOCAL_CWD=
SSH_AGENT_HOST=127.0.0.1

# Optional outbound Node fetch proxy; export before starting the backend.
# Lowercase http_proxy / https_proxy / no_proxy take precedence.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,[::1]
# Loopback is always bypassed. HTTP/HTTPS proxy URLs are supported; SOCKS ALL_PROXY is not used by fetch.

# Public browser configuration. Never put a secret in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SSH_AGENT_API_BASE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SSH_AGENT_EVENTS_BASE_URL=http://127.0.0.1:3002
